# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Connection string Supabase. Untuk proyek region Jakarta gunakan session pooler:
# postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Kunci enkripsi cookie reveal token QR (server-only, tanpa prefix NEXT_PUBLIC_)
# Buat dengan: openssl rand -hex 32
QR_TOKEN_SECRET=

# Google Gemini AI (server-only, untuk Tahap 3)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash

# Pollinations AI Image Generation (server-only, untuk Tahap 3)
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=flux
POLLINATIONS_IMAGE_BASE_URL=https://gen.pollinations.ai

# QR & PDF
NEXT_PUBLIC_QR_BASE_URL=http://localhost:3000/belajar

# Notifikasi / Email Opsional
RESEND_API_KEY=