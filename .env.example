# App
# PENTING: nilai ini juga menjadi alamat yang tertulis di kode QR. Untuk
# production isi domain Vercel, jangan alamat pratinjau, karena QR yang
# dicetak tidak boleh kedaluwarsa.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Connection string Supabase. Untuk proyek region Jakarta gunakan session pooler:
# postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Kunci enkripsi cookie reveal token QR (server-only, tanpa prefix NEXT_PUBLIC_)
# Buat dengan: openssl rand -hex 32
QR_TOKEN_SECRET=

# Google Gemini AI (server-only, untuk Tahap 3)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash

# Pollinations AI Image Generation (server-only, untuk Tahap 3)
POLLINATIONS_API_KEY=
# Nilai di bawah sudah diverifikasi tersedia, sehat, dan biayanya 0.002
# pollen per gambar. Alias简单的 "flux" juga boleh dipakai sebagai cadangan.
POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell
POLLINATIONS_IMAGE_BASE_URL=https://gen.pollinations.ai

# Diagnostik AI: isi 1 agar log FITRA-AI ikut tampil di production.
FITRA_AI_DEBUG=0

# Notifikasi / Email Opsional
RESEND_API_KEY=